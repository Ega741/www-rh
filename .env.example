# ---------- chain ----------
# 46630 = Robinhood Chain Testnet, 4663 = Robinhood Chain mainnet, 31337 = local anvil
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
# Overrides launchpadAddress(CHAIN_ID) from @www-rh/shared; the zero address counts as unset
LAUNCHPAD_ADDRESS=0x0000000000000000000000000000000000000000
# First block to index when the runner DB is empty (launchpad deployment block)
START_BLOCK=0
# Index only up to head - CONFIRMATIONS
CONFIRMATIONS=0

# ---------- operator (runner hot wallet; must equal MindLaunchpad.operator()) ----------
# Unset or 0x forces dry run
OPERATOR_PRIVATE_KEY=0x
# true = never send transactions (ticks still run and are charged locally)
DRY_RUN=true

# ---------- model provider ----------
ANTHROPIC_API_KEY=

# ---------- economics ----------
ETH_USD_PRICE=3000
# Optional Chainlink AggregatorV3 ETH/USD feed on Robinhood Chain; overrides ETH_USD_PRICE when set and fresh
ETH_USD_FEED=
# A mind is runnable when availableUsd >= max(MIN_TICK_BUDGET_USD, MAX_TICK_COST_USD)
MIN_TICK_BUDGET_USD=0.05
# Per-tick spend guard (USD)
MAX_TICK_COST_USD=0.25
# Settle (drawCompute) when unsettled spend reaches this (USD)
DRAW_THRESHOLD_USD=2
# Burn governor: target runway and minimum daily spend
TARGET_RUNWAY_DAYS=14
MIN_DAILY_SPEND_USD=0.5

# ---------- runner ----------
DB_PATH=./data/runner.sqlite
PORT=8787
# Comma-separated list of origins allowed by CORS
PUBLIC_WEB_ORIGIN=http://localhost:5173
MAX_CONCURRENT_MINDS=3
TICK_INTERVAL_MS=20000
TICK_MAX_ITERATIONS=8
TICK_TIMEOUT_MS=180000
ANCHOR_EVERY_N_MEMORIES=5
HARVEST_INTERVAL_MS=21600000
BROWSER_HEADLESS=true
FRAME_FPS=1
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ---------- web (Vite, build-time) ----------
VITE_CHAIN_ID=46630
# Overrides launchpadAddress(VITE_CHAIN_ID); the zero address counts as unset
VITE_LAUNCHPAD_ADDRESS=0x0000000000000000000000000000000000000000
# Dev: target of the Vite proxy for /api and /ws. Prod: API base (empty = same origin)
VITE_RUNNER_URL=http://localhost:8787
# Prod only: WebSocket URL (empty = same-origin /ws)
VITE_RUNNER_WS=ws://localhost:8787/ws
# Optional RPC override for the wallet transport (empty = chain default)
VITE_RPC_URL=
# Optional; enables the WalletConnect connector
VITE_WALLETCONNECT_PROJECT_ID=
# 1 = use Multicall3 (only if `cast code 0xcA11bde05977b3631167028862bE2a173976CA11` is non-empty)
VITE_MULTICALL=

# ---------- contracts deploy (forge script) ----------
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
DEPLOYER_PRIVATE_KEY=0x
# OWNER/TREASURY/COMPUTE_TREASURY/OPERATOR default to the deployer address when empty
OWNER=
TREASURY=
# Receives drawCompute payments (pays the model provider)
COMPUTE_TREASURY=
OPERATOR=
# uniswapv3 | mock
GRADUATOR_KIND=mock
WETH9=0x7943e237c7F95DA44E0301572D358911207852Fa
UNIV3_FACTORY=
UNIV3_POSITION_MANAGER=
UNIV3_FEE_TIER=10000
BLOCKSCOUT_API_KEY=unused
