# Beagle — one env file for the gateway, the web build and the cluster setup script (docs/SPEC.md §5.1).
#
# How this file is read:
#   gateway (bare metal): reads process.env ONLY and never opens this file. Pass it to Node:
#       node --env-file=.env gateway/dist/cli.js migrate
#       NODE_ENV=production node --env-file=.env gateway/dist/main.js
#     or export it for the shell (`set -a; source .env; set +a`, then `pnpm dev:gateway`), or EnvironmentFile= in systemd.
#   docker compose: `env_file: .env` injects the whole file into the gateway container (DEPLOYER_KEYPAIR / MINT_KEYPAIR are blanked).
#   web (Vite): reads the VITE_* keys from this repo-root file itself (envDir).
#   cluster setup: export the "cluster setup" section before `bash solana/scripts/setup-cluster.sh devnet|mainnet-beta`
#     (localnet needs nothing: it uses the committed test keys in solana/keys/). See docs/SOLANA.md.

# ---------- runtime ----------
# development | production | test. `production` turns on the production guards: SESSION_SECRET becomes required and
# `beagle-gateway credit` refuses without --force. Set it to production on every real deployment (the Docker image does).
NODE_ENV=development

# ---------- cluster ----------
# localnet (solana-test-validator, http://127.0.0.1:8899) | devnet | mainnet-beta
CLUSTER=localnet
# JSON-RPC endpoint; empty = the cluster default (http://127.0.0.1:8899 / https://api.devnet.solana.com /
# https://api.mainnet-beta.solana.com). Use a private RPC provider on mainnet: the public endpoint rate-limits (docs/SOLANA.md).
RPC_URL=
# Optional websocket endpoint (empty = derived from RPC_URL)
RPC_WS_URL=
# Overrides the mint of solana/deployments/<cluster>.json (via @beagle/shared); empty = the deployment's mint
MINT_ADDRESS=
# Overrides the token program of the deployment: TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA (Token) or
# TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb (Token-2022); empty = the deployment's
TOKEN_PROGRAM=
# confirmed | finalized — commitment of every RPC read and transaction confirmation
COMMITMENT=confirmed
# Optional start cursor: index only burns AFTER this transaction signature (set it at launch on a busy mint so the
# first run does not replay history). Empty = everything the RPC returns, newest INDEX_PAGE_LIMIT signatures per page.
INDEX_FROM_SIGNATURE=
INDEX_PAGE_LIMIT=1000
POLL_INTERVAL_MS=2000
# Parallel getTransaction fetches while indexing
TX_FETCH_CONCURRENCY=4

# ---------- operator (gateway hot wallet; signs budget draws = delegate BurnChecked + memo, nothing else) ----------
# base58 secret key (`bash solana/scripts/keypair.sh base58 <file>`) or the JSON byte array of a solana-keygen file.
# Its public key must equal `operator` in the deployment record. Fund it with a little SOL for fees.
# Empty → budget draws are disabled.
OPERATOR_SECRET_KEY=
# true = never send transactions (log instead)
DRY_RUN=true
# ComputeBudget priority fee added to draw transactions (0 = none)
PRIORITY_FEE_MICROLAMPORTS=0

# ---------- price (off-chain, published point by point; docs/SPEC.md §3.3) ----------
# manual (admin API / CLI set-price) | feed (PRICE_FEED_URL) | jupiter (Jupiter Price API by mint, mainnet only)
PRICE_SOURCE=manual
# manual: bootstrap price in USD per whole token when the history is empty (e.g. 0.01)
INITIAL_PRICE_USD=0.01
# feed: HTTP JSON endpoint returning { "priceUsd": <number> } for 1 whole token
PRICE_FEED_URL=
# jupiter: GET {JUPITER_PRICE_URL}?ids=<mint> → data[mint].usdPrice
JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v3
PRICE_REFRESH_MS=60000
# A new point is appended when the price moved ≥ this many bps (or the last point is older than PRICE_MAX_AGE_S / 2)
PRICE_MIN_CHANGE_BPS=50
# A refresh that jumps more than this many bps from the last point is rejected and logged
PRICE_MAX_STEP_BPS=2500
# The price is stale after this many seconds without a new point (web disables burning, MCP warns)
PRICE_MAX_AGE_S=3600
# true = burns observed while the price is stale are still credited at the last point (and flagged price_stale)
CREDIT_WHEN_STALE=true
# Burns quoting below this many USD are recorded with 0 credit (dust guard)
MIN_CREDIT_USD=0.001

# ---------- budgets (SPL delegation to the operator; docs/SPEC.md §3.4) ----------
# getProgramAccounts scan for token accounts of the mint delegated to the operator
BUDGET_SCAN_INTERVAL_MS=30000
# Refresh of delegate / delegatedAmount / balance of the open budgets
BUDGET_HEADROOM_REFRESH_MS=15000
# Draw from a budget when the workspace deficit reaches this many USD
DRAW_THRESHOLD_USD=1
DRAW_INTERVAL_MS=30000
# A sent draw whose signature is still unknown after this long (and whose blockhash expired) is marked failed
DRAW_CONFIRM_TIMEOUT_MS=90000

# ---------- server ----------
PORT=8787
HOST=0.0.0.0
# Public URL of the gateway: SIWS domain/uri, links in receipts
PUBLIC_URL=http://localhost:8787
# Comma-separated origins allowed by CORS (the web app)
PUBLIC_WEB_ORIGIN=http://localhost:5173
DB_PATH=./data/gateway.sqlite
MAX_BODY_BYTES=2000000
# Reserved: parsed but not honoured yet (no X-Forwarded-* handling; the Secure cookie flag follows PUBLIC_URL); leave false
TRUST_PROXY=false
LOG_LEVEL=info
# true = include prompts/completions in logs (never in production)
LOG_PROMPTS=false

# ---------- secrets ----------
# Random 32+ bytes; required in production (sessions are signed with it)
SESSION_SECRET=
# 32-byte hex key for AES-256-GCM encryption of BYOK provider keys; required when BYOK is used
KEYRING_MASTER_KEY=
# Enables /api/admin/* (credit adjustments, manual price points) when set
ADMIN_TOKEN=

# ---------- model providers (platform keys; absent = provider unavailable for credit-paid routing) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# House model (vLLM / Ollama OpenAI-compatible endpoint); empty = house tier disabled
HOUSE_BASE_URL=
HOUSE_API_KEY=
HOUSE_MODEL_SMALL=openai/gpt-oss-20b
HOUSE_MODEL_LARGE=openai/gpt-oss-120b
# Upstream timeout: whole call for JSON responses; time-to-first-byte and then idle timeout between chunks for streams
PROVIDER_TIMEOUT_MS=120000
# Optional JSON file merged over the default catalog (prices, ids, removals)
MODEL_CATALOG_FILE=

# ---------- economics ----------
# Markup on upstream cost for credit-paid requests (basis points)
MARKUP_BPS=1000
# Fee on requests served through the workspace's own provider keys (basis points)
BYOK_FEE_BPS=0
LOW_CREDIT_USD=1
VERY_LOW_CREDIT_USD=0.1
MIN_RESERVE_USD=0.01
MAX_RESERVE_USD=5
RESERVATION_TTL_MS=600000
PRO_PRICE_USD=20
PRO_DAYS=30
WARM_HOUR_PRICE_USD=2
RATE_LIMIT_RPM=60
RATE_LIMIT_RPM_PRO=300
# log | ollama | http
WARM_DRIVER=log
WARM_WEBHOOK_URL=
WARM_PING_INTERVAL_MS=240000

# ---------- web (Vite, build-time; docs/SPEC.md §7) ----------
# Must match the gateway's CLUSTER: localnet | devnet | mainnet-beta
VITE_CLUSTER=localnet
# Optional RPC override for the wallet connection (empty = cluster default)
VITE_RPC_URL=
# Dev: target of the Vite proxy for /api, /v1, /mcp and the SIWS domain (must equal the gateway's PUBLIC_URL).
# Prod: API base (empty = same origin behind nginx; then PUBLIC_URL = the site URL). The web reads this repo-root .env (vite envDir).
VITE_GATEWAY_URL=http://localhost:8787
# Overrides the mint of the committed deployment the page reconciles /api/config against; empty = deployment mint
VITE_MINT_ADDRESS=

# ---------- cluster setup (bash solana/scripts/setup-cluster.sh devnet | mainnet-beta; docs/SOLANA.md) ----------
# Not read by the gateway. localnet ignores these and uses solana/keys/* (committed TEST keys).
# Path to the fee payer / mint authority keypair (devnet mint creation). Keep it out of any .env a gateway is started with.
DEPLOYER_KEYPAIR=
# Public key of the gateway operator to record in solana/deployments/<cluster>.json
OPERATOR_PUBKEY=
# Optional path to the mint keypair when creating a mint (random when empty)
MINT_KEYPAIR=
# Record an existing mint instead of creating one (mainnet: the pump.fun-launched BEAGLE)
EXISTING_MINT=
