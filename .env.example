# Beagle — one env file for the gateway, the web build and the contract scripts (docs/SPEC.md §5.1).
#
# How this file is read:
#   gateway (bare metal): reads process.env ONLY and never opens this file. Pass it to Node:
#       node --env-file=.env gateway/dist/cli.js migrate
#       NODE_ENV=production node --env-file=.env gateway/dist/main.js
#     or export it for the shell (`set -a; source .env; set +a`, then `pnpm dev:gateway`), or EnvironmentFile= in systemd.
#   docker compose: `env_file: .env` injects the whole file into the gateway container (DEPLOYER_PRIVATE_KEY is blanked).
#   web (Vite): reads the VITE_* keys from this repo-root file itself (envDir).
#   contracts: export the "contracts deploy" section in the shell before `forge script` (docs/DEPLOY.md §2).

# ---------- runtime ----------
# development | production | test. `production` turns on the production guards: SESSION_SECRET becomes required and
# `beagle-gateway credit` refuses without --force. Set it to production on every real deployment (the Docker image does).
NODE_ENV=development

# ---------- chain ----------
# 31337 = local anvil, 46630 = Robinhood Chain Testnet, 4663 = Robinhood Chain mainnet
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Overrides the CreditDesk address from contracts/deployments/<chainId>.json; the zero address counts as unset
CREDIT_DESK_ADDRESS=0x0000000000000000000000000000000000000000
# First block to index when the DB is empty (default: deployBlock of the deployment)
START_BLOCK=
# Index only up to head - CONFIRMATIONS (Arbitrum Orbit chains practically never reorg)
CONFIRMATIONS=0
POLL_INTERVAL_MS=2000
LOG_CHUNK_BLOCKS=2000

# ---------- operator (gateway hot wallet; must equal operator() of the CreditDesk and poster of the price source) ----------
# Empty or 0x → budget draws and price posts are disabled
OPERATOR_PRIVATE_KEY=0x
# true = never send transactions (log instead)
DRY_RUN=true

# ---------- price poster (ManualPriceSource) ----------
PRICE_POSTER_ENABLED=false
# Defaults to priceSource from the deployment
PRICE_SOURCE_ADDRESS=
# HTTP JSON endpoint returning { "priceUsd": <number> } for 1 whole token
PRICE_FEED_URL=
PRICE_POST_INTERVAL_MS=300000

# ---------- budgets ----------
# Draw from an agent budget when the workspace deficit reaches this many USD (or the budget expires within 1 h)
DRAW_THRESHOLD_USD=1
DRAW_INTERVAL_MS=30000
BUDGET_HEADROOM_REFRESH_MS=15000

# ---------- server ----------
PORT=8787
HOST=0.0.0.0
# Public URL of the gateway: SIWE domain/uri, links in receipts
PUBLIC_URL=http://localhost:8787
# Comma-separated origins allowed by CORS (the web app)
PUBLIC_WEB_ORIGIN=http://localhost:5173
DB_PATH=./data/gateway.sqlite
MAX_BODY_BYTES=2000000
# Reserved: parsed but not honoured yet (no X-Forwarded-* handling; the Secure cookie flag follows PUBLIC_URL); leave false
TRUST_PROXY=false
LOG_LEVEL=info
# true = include prompts/completions in logs (never in production)
LOG_PROMPTS=false

# ---------- secrets ----------
# Random 32+ bytes; required in production (sessions are signed with it)
SESSION_SECRET=
# 32-byte hex key for AES-256-GCM encryption of BYOK provider keys; required when BYOK is used
KEYRING_MASTER_KEY=
# Enables /api/admin/* when set
ADMIN_TOKEN=

# ---------- model providers (platform keys; absent = provider unavailable for credit-paid routing) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# House model (vLLM / Ollama OpenAI-compatible endpoint); empty = house tier disabled
HOUSE_BASE_URL=
HOUSE_API_KEY=
HOUSE_MODEL_SMALL=openai/gpt-oss-20b
HOUSE_MODEL_LARGE=openai/gpt-oss-120b
# Upstream timeout: whole call for JSON responses; time-to-first-byte and then idle timeout between chunks for streams
PROVIDER_TIMEOUT_MS=120000
# Optional JSON file merged over the default catalog (prices, ids, removals)
MODEL_CATALOG_FILE=

# ---------- economics ----------
# Markup on upstream cost for credit-paid requests (basis points)
MARKUP_BPS=1000
# Fee on requests served through the workspace's own provider keys (basis points)
BYOK_FEE_BPS=0
LOW_CREDIT_USD=1
VERY_LOW_CREDIT_USD=0.1
MIN_RESERVE_USD=0.01
MAX_RESERVE_USD=5
RESERVATION_TTL_MS=600000
PRO_PRICE_USD=20
PRO_DAYS=30
WARM_HOUR_PRICE_USD=2
RATE_LIMIT_RPM=60
RATE_LIMIT_RPM_PRO=300
# log | ollama | http
WARM_DRIVER=log
WARM_WEBHOOK_URL=
WARM_PING_INTERVAL_MS=240000

# ---------- web (Vite, build-time) ----------
VITE_CHAIN_ID=31337
# Dev: target of the Vite proxy for /api, /v1, /mcp and the SIWE domain (must equal the gateway's PUBLIC_URL).
# Prod: API base (empty = same origin behind nginx; then PUBLIC_URL = the site URL). The web reads this repo-root .env (vite envDir).
VITE_GATEWAY_URL=http://localhost:8787
# Overrides the CreditDesk address from @beagle/shared deployments; the zero address counts as unset
VITE_CREDIT_DESK_ADDRESS=0x0000000000000000000000000000000000000000
# Optional RPC override for the wallet transport (empty = chain default)
VITE_RPC_URL=
# Optional; enables the WalletConnect connector
VITE_WALLETCONNECT_PROJECT_ID=
# 1 = use Multicall3 (only if `cast code 0xcA11bde05977b3631167028862bE2a173976CA11` is non-empty on your RPC)
VITE_MULTICALL=

# ---------- contracts deploy (forge script script/Deploy.s.sol) ----------
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
# Deploy-only secret for `forge script`: the gateway never needs it. docker compose blanks it in the gateway container;
# keep it out of the .env a bare-metal gateway is started with (`--env-file` would hand it to the gateway process).
DEPLOYER_PRIVATE_KEY=0x
# Existing ERC-20 to accept (e.g. the Pons-launched token on mainnet); empty = deploy BeagleToken
TOKEN=
TOKEN_RECIPIENT=
# true = token implements ERC20Burnable.burn; false = burn by transfer to 0x…dEaD (required when TOKEN is set)
NATIVE_BURN=
# OWNER / OPERATOR / POSTER default to the deployer address when empty
OWNER=
OPERATOR=
POSTER=
# Bootstrap price (USD per token, 18 decimals); 0 = leave unset
INITIAL_PRICE_E18=0
MAX_PRICE_AGE=3600
MIN_BURN=0
BLOCKSCOUT_API_KEY=unused
