{
  "name": "@www-rh/runner",
  "version": "0.1.0",
  "private": true,
  "description": "www-rh runner: chain indexer, mind scheduler (Claude + headless browser), memory, compute economics, HTTP API and WebSocket stream",
  "type": "module",
  "license": "MIT",
  "main": "./dist/main.js",
  "bin": {
    "www-rh-runner": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "cli": "node dist/cli.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.3",
    "@www-rh/shared": "workspace:*",
    "hono": "^4.13.12",
    "playwright": "1.56.1",
    "viem": "^2.57.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
