{
  "name": "@beagle/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Beagle gateway: CreditDesk indexer, model router, metering, OpenAI/Anthropic-compatible API, dashboard API, MCP over HTTP, operator jobs",
  "type": "module",
  "license": "MIT",
  "main": "./dist/main.js",
  "bin": {
    "beagle-gateway": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "cli": "node dist/cli.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@beagle/mcp": "workspace:*",
    "@beagle/shared": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "viem": "^2.57.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
