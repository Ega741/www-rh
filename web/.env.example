# Web app (Vite) — copy to web/.env.local. Only VITE_* variables reach the browser bundle.

# Chain the app targets: 46630 = Robinhood Chain Testnet, 4663 = Robinhood Chain mainnet, 31337 = local anvil.
VITE_CHAIN_ID=46630

# MindLaunchpad address. When empty or zero, the app falls back to launchpadAddress(chainId) from
# @www-rh/shared (generated from contracts/deployments/<chainId>.json by scripts/sync-deployments.mjs).
VITE_LAUNCHPAD_ADDRESS=

# Optional RPC override for the app's own wagmi transport (e.g. a private endpoint). Defaults to the
# chain definition's RPC in @www-rh/shared (anvil: http://127.0.0.1:8545). Not sent to wallets.
VITE_RPC_URL=

# Runner (API + WebSocket).
# Dev: the Vite server proxies /api and /ws to VITE_RUNNER_URL (default http://localhost:8787) and the
# browser uses relative URLs. Prod build: the browser calls VITE_RUNNER_URL (empty = same origin) and
# connects to VITE_RUNNER_WS (empty = same-origin /ws).
VITE_RUNNER_URL=http://localhost:8787
VITE_RUNNER_WS=ws://localhost:8787/ws

# Optional WalletConnect v2 project id; when empty only injected wallets (MetaMask, Rabby, ...) are offered.
VITE_WALLETCONNECT_PROJECT_ID=

# Set to 1 to declare Multicall3 on the chain and batch reads through it (only after checking that
# 0xcA11bde05977b3631167028862bE2a173976CA11 has code on the target chain).
VITE_MULTICALL=0
