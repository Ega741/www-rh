{
  "name": "beagle",
  "private": true,
  "version": "0.1.0",
  "description": "Beagle: compute for agents on Solana. One API key for every model, paid for by burning BEAGLE.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/shared --filter ./packages/mcp --filter ./gateway --filter ./web run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "dev:gateway": "pnpm --filter @beagle/gateway dev",
    "dev:web": "pnpm --filter @beagle/web dev",
    "deployments:sync": "node scripts/sync-deployments.mjs",
    "cluster:setup": "bash solana/scripts/setup-cluster.sh localnet",
    "mock:provider": "node scripts/mock-provider.mjs",
    "solana:e2e": "bash scripts/solana-e2e.sh"
  }
}
