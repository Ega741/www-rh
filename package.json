{
  "name": "www-rh",
  "private": true,
  "version": "0.1.0",
  "description": "worldwideweb on Robinhood Chain — every coin has a mind",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/shared --filter ./runner --filter ./web run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "dev:runner": "pnpm --filter @www-rh/runner dev",
    "dev:web": "pnpm --filter @www-rh/web dev",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "abi:sync": "node scripts/sync-abi.mjs",
    "deployments:sync": "node scripts/sync-deployments.mjs",
    "anvil:e2e": "bash scripts/anvil-e2e.sh"
  }
}
